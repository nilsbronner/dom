# ============================================================
# GRUB DOM — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# ============================================================

# --- Gemini AI (obligatoire pour toutes les analyses IA) ---
# Obtenir sur : https://aistudio.google.com/apikey
GEMINI_API_KEY=
API_KEY=   # alias du GEMINI_API_KEY

# --- Supabase (obligatoire pour la persistence des données) ---
# Obtenir sur : https://supabase.com → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Google Drive (optionnel - ancienne méthode, remplacée par Supabase) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_DRIVE_PARENT_FOLDER_ID=
